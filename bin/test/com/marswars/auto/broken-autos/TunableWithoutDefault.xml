<?xml version="1.0" encoding="UTF-8"?>
<!-- The tree declares a speed port but gives it no default, so it is never set before the run. -->
<root BTCPP_format="4" main_tree_to_execute="TunableWithoutDefault">
  <BehaviorTree ID="TunableWithoutDefault">
    <Follow trajectory="P1" speed="{speed}"/>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="TunableWithoutDefault">
      <input_port name="speed" type="double">Cruise speed</input_port>
    </SubTree>
  </TreeNodesModel>
</root>
